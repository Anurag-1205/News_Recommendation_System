# ============================================================================
# Mandated by A1 Q8 — no large files in version control.
# ============================================================================
*.zip
*.pt
*.ckpt
__pycache__/
data/

# ============================================================================
# Environment and tooling caches.
# ============================================================================
.venv/
venv/
*.pyc
.python-version
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
.vscode/
.idea/

# ============================================================================
# Large artifacts, guarded even outside data/.
# ============================================================================
*.parquet
*.npy
*.faiss
*.bin
*.tar.gz

# Exception: toy fixtures are small and are the oracles for the retrievers.
!tests/fixtures/**

# ============================================================================
# Submitted through other channels, deliberately not in the repository.
# ============================================================================
# AI-usage prompts — submitted separately, not via GitHub
prompts/
# Assembled Moodle bundle, regenerated on demand by scripts/make_deliverables.sh
report/deliverables/
# Leaderboard screenshots — submitted with the report
report/*.png
report/*.jpg

# Third-party baseline code (e.g. ebnerd-benchmark for NRMS); commit hash pinned in CONTEXT.md.
external/
# Credentials — never in git, even if one is copied into the repo by mistake.
kaggle.json

# ============================================================================
# Local working documents, not assignment deliverables.
# CLAUDE.md, PLAN.md, CONTEXT.md and AI_USAGE.md are tracked on the A2 branch so both team
# members' agents share them (CONTEXT.md C-002).
# ============================================================================
LEARNING_NOTES.md
ebnerd_analysis.ipynb
mind_analysis.ipynb

# ============================================================================
# Design-note build artifacts and the Moodle deliverable itself.
# The note is submitted through Moodle, not via GitHub.
# ============================================================================
report/*.tex
report/*.pdf
report/*.aux
report/*.out
report/*.synctex.gz
report/*.html
report/*.css
